@model List<FinanceTracker.Domain.Entities.Transaction>

@{
    ViewData["Title"] = "Транзакции";
}

<h1>Транзакции</h1>

<a asp-controller="Transactions"
   asp-action="Create"
   class="btn btn-primary">
    Добавить транзакцию
</a>

<br />
<br />

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Тип</th>
            <th>Сумма</th>
            <th>Категория</th>
            <th>Описание</th>
            <th>Дата</th>
            <th>Действие</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var transaction in Model)
        {
            <tr>
                <td>@transaction._type</td>
                <td>@transaction._amount</td>
                <td>@string.Join(", ", transaction._category)</td>
                <td>@transaction._description</td>
                <td>@transaction._date</td>

                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden"
                               name="id"
                               value="@transaction._id" />

                        <button type="submit" class="btn btn-danger">
                            Удалить
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>