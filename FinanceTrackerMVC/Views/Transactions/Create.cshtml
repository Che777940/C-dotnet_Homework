@model FinanceTracker.Domain.Entities.Transaction

<h2>Добавить транзакцию</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Тип транзакции</label>

        <select asp-for="_type">
            <option value="Income">Доход</option>
            <option value="Expense">Расход</option>
        </select>
    </div>

    <div>
        <label>Сумма</label>
        <input asp-for="_amount" type="number" step="0.01" />
    </div>

    <div>
        <label>Категория 1</label>
        <input name="_category" />
    </div>

    <div>
        <label>Категория 2</label>
        <input name="_category" />
    </div>

    <div>
        <label>Описание</label>
        <input asp-for="_description" />
    </div>

    <button type="submit">Добавить</button>

</form>
