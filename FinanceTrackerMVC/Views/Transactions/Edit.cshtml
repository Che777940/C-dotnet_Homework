@model FinanceTracker.Domain.Entities.Transaction

@{
    ViewData["Title"] = "Редактирование транзакции";
}

<h1>Редактирование транзакции</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="_id" />

    <div class="mb-3">
        <label>Тип</label>
        <select asp-for="_type" class="form-control">
            <option value="Income">Доход</option>
            <option value="Expense">Расход</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Сумма</label>
        <input asp-for="_amount"
               type="number"
               step="0.01"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Категория 1</label>
        <input name="_category"
               value="@Model._category[0]"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Категория 2</label>
        <input name="_category"
               value="@Model._category[1]"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <input asp-for="_description"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Дата</label>
        <input asp-for="_date"
               type="date"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Сохранить
    </button>

    <a asp-action="Transaction" class="btn btn-secondary">
        Отмена
    </a>

</form>